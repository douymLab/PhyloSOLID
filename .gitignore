*.log.*

# ============================================
# Demo data
# Live runs stay local. Tracked snapshots live in demo/*/expected_output/
# ============================================
demo/input/*/01_rawdata/*.bam
demo/input/*/01_rawdata/*.bam.bai
demo/*/output/

# Keep scDNA target-site mini BAMs (indexes are built by run_demo.sh)
!demo/scdna/input/bam/
!demo/scdna/input/bam/*.bam
!demo/scdna/input/*.bed
!demo/scdna/input/target_sites.bed

# ============================================
# Configuration files (keep templates, ignore local paths)
# ============================================
config/paths.yaml
!config/paths.yaml.template
*.local.yaml
*.secret.yaml

